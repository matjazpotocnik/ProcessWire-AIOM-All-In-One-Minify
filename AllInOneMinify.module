	}

	/**
	 * Create the cache folder in the /site/assets/.
	 *
	 * @return void
	 * @throws WireException
	 */
	public function ___install() {
		$dir = self::$assetsCacheDir;

		if(!is_dir($dir) && wireMkdir($dir) === false) {
			throw new WireException("The cache folder $dir could not be created.");
		}

		$pr = wire()->modules->get('PageRender');
		if(!$pr) {
			throw new WireException('PageRender module is not installed.');
		}
	}

	/**
	 * Remove the cache folders /site/assets/aiom/ and /site/assets/cache/aiom/
	 *
	 * @return void
	 */
	public function ___uninstall() {

		$paths = [self::$assetsCacheDir, self::$aiomCacheDir];

		foreach($paths as $dir) {
			if(!is_dir($dir)) continue;
			wireChmod($dir);
			if(wireRmdir($dir, true) === false) {
				$this->warning("The folder $dir could not be removed.");
			}
		}
	}

	/**
	 * Set hooks
	 *
	 * @return void
	 */
	public function ready() {

		$config = wire()->config;
		$input = wire()->input;
		$page = wire()->page;

		if($input->get('cache') === 'clear' && $page->template->name === 'admin') self::clearAssetsCacheFromBackend();
		if($input->get('pagecache') === 'clear' && $page->template->name === 'admin') self::clearAiomCacheFromBackend();

		//js needed only if using WireTabs with custom wiretabid
		//$config->scripts->add($config->urls->siteModules . __CLASS__ . '/' . __CLASS__ . '.js');//?v=' . time());
		$config->styles->add($config->urls->siteModules . __CLASS__ . '/' . __CLASS__ . '.css');//?v=' . time());

		// Check if template files are newer than cache file
		if($page->template->name !== 'admin' && $page->template->cache_time > 0 && self::$configData['template_files'] !== '') {
			$this->addHookBefore('Page::render', $this, '_checkTemplateFiles');
		}

		if((
				self::$configData['html_minify'] != 1 &&
				self::$configData['css_minify'] != 1 &&
				self::$configData['js_minify'] != 1 &&
				self::$configData['cache_enable'] != 1) ||
				//self::$configData['development_mode'] == 1 || //todo: should development mode affect caching?
				($page->template->name === 'admin' || $page->template->name === 'user')) return;

		if(self::$configData['cache_enable'] == 1) {
			if(!is_file(self::$aiomCacheDir . 'aiom.enabled')) @file_put_contents(self::$aiomCacheDir . 'aiom.enabled', time());
		} else {
			if(is_file(self::$aiomCacheDir . 'aiom.enabled')) @unlink(self::$aiomCacheDir . 'aiom.enabled');
		}

		// Check if the current template requires SSL.
		$this->addHookBefore('Page::render', $this, '_checkSSL');

		// Add a hook that is called after rendering the page and minimize the
		// generated html source code, inlined js/css files and create a cache file.
		$this->addHookAfter('Page::render', $this, 'HTML', ['priority' => 199]);

		// Check if already cached files longer than the configured time exist.
		// If so, remove those files.
		self::_clearAssetsCache();
	}


	/**
	 * Minifies, combines, and caches one or more JavaScript files.
	 *
	 * Accepts a single JavaScript path or an array of them. Each file is minimized,
	 * concatenated with others, and written into a single cached asset file.
	 * Returns the public URL to the generated asset.
	 *
	 * @param string|array<int,string>|FilenameArray $javascripts
	 *     A JavaScript file path or array of file paths relative to the templates
	 *     directory.
	 *
	 *     Examples:
	 *     - `'js/main.js'`
	 *     - `['lib.js', 'app.js']`
	 *     - `$config->scripts`
	 *
	 * @return string
	 *     Public URL to the combined and minimized JavaScript file eg.
	 *     `/site/assets/aiom/js_1f259989ada30d54ea095abce48b228c.js`
	 *
	 * @example
	 *     echo "<script src='" . AIOM::JS(['js/vendor.js', 'js/main.js']); . "'></script>";
	 *
	 * @example
	 *     <script src="<?= AIOM::JS('app.js'); ?>"></script>
	 *
	 * @example
	 *     // Using PW config scripts (FilenameArray)
	 *     <script src="<?= AIOM::JS($config->scripts); ?>"></script>
	 *
	 * @example
	 *     // Using custom FilenameArray
	 *     $js = new FilenameArray();
	 *     $js->add('js/vendor.js');
	 *     $js->add('js/main.css');
	 *     echo "<script src='" . AIOM::JS($js); . "'></script>";
	 */
		public static function JS($javascripts) {
		if(empty($javascripts)) throw new WireException('There were no javascript files specified to minimize.');

		// support for FilenameArray eg. $config->scripts
		if(($javascripts instanceof FilenameArray)) {
			$javascripts = (array) $javascripts->getIterator(); // Convert to array
		}

		$javascripts = (array) $javascripts;
		$javascripts = self::_fileArray($javascripts, '.js');
		$cacheFile   = self::_getCacheName($javascripts, (string) self::$configData['javascript_prefix'], '.js');
		$assetDomain = self::_getAssetDomain();
		$cachePath   = self::$assetsCacheDir . $cacheFile;
		$isDev       = self::$configData['development_mode'] == 1;
		$config      = wire()->config;
		//bd($javascripts, "JS() javascripts array");

		// Check if there is already a combined and cached file. If not, generate a new minimized cache file.
		if(!file_exists($cachePath) || $isDev) {
			//bd($cachePath, "JS() cachePath does not exist, creating a new one");

			// Load the minimization library - PHP implementation of Douglas Crockford's JSMin
			// https://code.google.com/p/minify/source/browse/min/lib/JSMin.php?name=2.1.7
			$lib = $config->paths->siteModules . __CLASS__ . '/lib/';
			require_once(/*NoCompile*/ $lib . 'JSMin.php');

			// Expire pages cache files if template caching is enabled.
			self::_clearPagesCache();

			$_js = '';
			foreach($javascripts as $javascript) {
				//bd($javascript, "JS() processing javascript");
				$jsFileName = $javascript['absolute_path'];
				$content = file_get_contents($jsFileName);
				if($content === false) continue;

				if(!$isDev && !self::_isMinimized($jsFileName)) {
					$content = JSMin::minify($content);
					//$content = self::_minifyJS($content); //alternative
				}

				$_js .= $content . PHP_EOL;
			}

			$_js = rtrim($_js, PHP_EOL);

			// Write the minimized file to the file system.
			if(@file_put_contents($cachePath, self::_generatorInformation($_js), LOCK_EX) !== false) {
				/** @phpstan-ignore if.alwaysTrue */
				if(self::DEBUG) self::_log("$cachePath created");
				@wireChmod($cachePath);
			} else {
				self::_log("ERROR: file_put_contents($cachePath) failed");
			}
		}

		// Return the absolute URL path to the minimized file.
		$suffix = $isDev ? '?no-cache=' . time() : '';
		return $assetDomain . '/' . $cacheFile . $suffix;
	}

	/**
	 * Minifies, combines, rewrites URLs, and caches one or more stylesheet files.
	 *
	 * Accepts a single stylesheet path or an array of them, processes
	 * each file (CSS or LESS), rewrites relative URLs to root-relative paths,
	 * minimizes the resulting content, and stores the combined output in
	 * a cache file. Returns the public URL to the generated asset.
	 *
	 * LESS files are compiled using the included LESS parser. When running on
	 * virtual host configurations, import directories are adjusted to keep
	 * relative `@import` paths functional.
	 *
	 * @param string|array<int,string>|FilenameArray $stylesheets
	 *     A stylesheet path (e.g. `"css/main.css"`) or a list of stylesheet
	 *     paths relative to the template directory. A ProcessWire `FilenameArray`
	 *     (such as `$config->styles`) is also supported.
	 *
	 *     Examples:
	 *     - `'css/style.css'`
	 *     - `['css/reset.css', 'css/layout.css']`
	 *     - `$config->styles`
	 *
	 * @param array<string, string>|null $lessVars
	 *     Optional LESS variables to inject when compiling `.less` files.
	 *     Example: `['colorPrimary' => '#f00']`
	 *
	 * @return string
	 *     The public URL to the combined and minimized stylesheet eg.
	 *     `/site/assets/aiom/css_94aa3617a3252dca4262cca287709c96.css`
	 *
	 * @example
	 *     // Combine two stylesheets
	 *     echo "<link rel='stylesheet' href='" . AIOM::CSS(['css/base.css', 'css/home.css']); . "'>";
	 *
	 * @example
	 *     // Compile LESS with variables
	 *     <link rel="stylesheet" href="<?= AIOM::CSS('css/styles.less', ['brandColor' => '#1e88e5']); ?>">
	 *
	 * @example
	 *     // Using PW config styles (FilenameArray)
	 *     <link rel="stylesheet" src="<?= AIOM::CSS($config->styles); ?>"></script>
	 *
	 * @example
	 *     // Using own FilenameArray array
	 *     $css = new FilenameArray();
	 *     $css->add('css/base.css');
	 *     $css->add('css/home.css');
	 *     echo "<link rel='stylesheet' href='" . AIOM::CSS($css) . "'>";
	 */
		public static function CSS($stylesheets, $lessVars = null) {
		if(empty($stylesheets)) throw new WireException('There were no stylesheet files specified to minimize.');

		// Support passing of $config->styles as argument which is of type FilenameArray
		if(($stylesheets instanceof FilenameArray)) {
			$stylesheets = (array) $stylesheets->getIterator(); // Convert to array
		}

		$stylesheets = (array) $stylesheets;
		$stylesheets = self::_fileArray($stylesheets, ['.css', '.less']);
		$cacheFile   = self::_getCacheName($stylesheets, (string) self::$configData['stylesheet_prefix'], '.css');
		$assetDomain = self::_getAssetDomain();
		$cachePath   = self::$assetsCacheDir . $cacheFile;
		$isDev       = self::$configData['development_mode'] == 1;
		$config      = wire()->config;
		$sanitizer   = wire()->sanitizer;
		//bd($stylesheets, "CSS() stylesheets array");

		// Check if there is already a combined and cached file. If not, generate a new minimized cache file.
		if(!file_exists($cachePath) || $isDev) {
			//bd($cacheFile, "CSS() cachefile does not exist, creating a new one");

			// Load the css minimization library - PHP port of the CSS minification tool distributed with YUICompressor.
			// https://github.com/tubalmartin/YUI-CSS-compressor-PHP-port, version 2.4.8-4
			//https://processwire.com/talk/topic/5630-module-aiom-all-in-one-minify-for-css-less-js-and-html/?page=8&tab=comments#comment-155120
			//require_once(wire()->config->paths->AllInOneMinify.'lib'.DIRECTORY_SEPARATOR.'cssmin.php'); //original AIOM version
			$lib = $config->paths->siteModules . __CLASS__ . '/lib/';
			require_once(/*NoCompile*/ $lib . 'CssMin/Minifier.php');
			require_once(/*NoCompile*/ $lib . 'CssMin/Colors.php');
			require_once(/*NoCompile*/ $lib . 'CssMin/Utils.php');

			// Load the URL rewriting library - rewrite relative to root-relative URIs
			// https://github.com/mrclay/minify/blob/master/lib/Minify/CSS/UriRewriter.php
			require_once(/*NoCompile*/ $lib . 'UriRewriter.php');

			// Expire pages cache files if template caching is enabled.
			self::_clearPagesCache();

			$_css = '';

			//todo: still not working?
			//https://github.com/Philzen/ProcessWire-AIOM-All-In-One-Minify/commit/a7d7dbc0f1d484eb16b00c6d1378d24c086d8a09
			// use a helper variable to hold the 'mixed' data from the superglobal
			$scriptName = $sanitizer->text($_SERVER['SCRIPT_NAME'] ?? '');
			$scriptFilename = $sanitizer->text($_SERVER['SCRIPT_FILENAME'] ?? '');
			$documentRoot = $sanitizer->text($_SERVER['DOCUMENT_ROOT'] ?? '');
			$isVirtualHost = $documentRoot !== str_replace($scriptName, '', $scriptFilename);

			// Processes each stylesheet by loading its content, compiling LESS if needed, rewriting URLs,
			// optionally minifying it, and appending the result to the combined CSS output.
			foreach ($stylesheets as $stylesheet) {
				//bd($stylesheet, "CSS() processing stylesheet");
				$cssFileName = $stylesheet['absolute_path'];
				$content = file_get_contents($cssFileName);
				if($content === false) continue;

				// If LESS file then run LESS parser.
				if($stylesheet['file_extension'] === 'less') {
					// Load the LESS compiler Library !!!OBSOLETE!!!
					// http://lessphp.gpeasy.com/ v1.7.1
					require_once($lib . 'Less/Less.php');
					//require_once($lib . 'WikiLess/lessc.inc.php'); alternative, but requires PHP 8.1+

					try {
						//https://github.com/gr4y/ProcessWire-AIOM-All-In-One-Minify/commit/e4fc75f2b9e92dc8ab09573c985f3f900b71cb43
						$_less_parser = new \Less_Parser(['sourceMap' => $isDev]);
						//https://github.com/FlipZoomMedia/ProcessWire-AIOM-All-In-One-Minify/pull/50/commits/7c0c6f333459faf4c9156546fcc635ce26c73f8f
						if($isVirtualHost) {
							$relDir = '/' . str_replace((string) $config->paths->root, '', dirname($cssFileName)) . '/';
							/** @phpstan-ignore-next-line because LESS accepts dir=>path pairs */
							$_less_parser->SetImportDirs([dirname($cssFileName) . '/' => $relDir]);
						}
						$_less_parser->parse($content);
						if($lessVars) $_less_parser->ModifyVars($lessVars);
						$content = $_less_parser->getCss();

					} catch(\Exception $e) {
						$content = '#_____LESS_____ERROR_____REPORT_____ {content:"' . $e->getMessage() . '"}';
					}
				}

				// Minimize generated css
				//https://processwire.com/talk/topic/5630-module-aiom-all-in-one-minify-for-css-less-js-and-html/?page=8&tab=comments#comment-155120
				//https://github.com/Philzen/ProcessWire-AIOM-All-In-One-Minify/commit/a7d7dbc0f1d484eb16b00c6d1378d24c086d8a09
				//$cssMin = new CSSmin(); //original AIOM
				if(!$isDev && !self::_isMinimized($cssFileName)) {
					$content = \Minify_CSS_UriRewriter::rewrite($content, dirname($cssFileName), $isVirtualHost ? $config->paths->root : null);
					$cssMin = new \tubalmartin\CssMin\Minifier();
					$content = $cssMin->run($content);
					//$content = self::_minifyCSS($content); //alternative
				}

				$_css .= $content . PHP_EOL;
			}

			$_css = rtrim($_css, PHP_EOL);

			// Write the minimized file to the file system.
			if(@file_put_contents($cachePath, self::_generatorInformation($_css), LOCK_EX) !== false) {
				/** @phpstan-ignore if.alwaysTrue */
				if(self::DEBUG) self::_log("$cachePath created");
				@wireChmod($cachePath);
			} else {
				self::_log("ERROR: file_put_contents($cachePath) failed");
			}
		}

		// Return the absolute URL path to the minimized file.
		$suffix = $isDev ? '?no-cache=' . time() : '';
		return $assetDomain . '/' . $cacheFile . $suffix;
	}

	/**
	 * Expire aiom cache folder
	 * @return int $numRemoved Number of deleted files
	 */
	private static function _clearAiomCache() {
		$num = self::_getNumberOfAiomCacheFiles(true); //true as parameter deletes the files
		$numRemoved = (int) $num['numberOfFiles'];

		$ret = wireRmdir(self::$aiomCacheDir, true);
		if($ret === false) {
			self::_log("ERROR: wireRmdir(" . self::$aiomCacheDir . ", true) failed");
		}
		wireMkdir(self::$aiomCacheDir);

		if(self::$configData['cache_enable'] == 1) {
			if(!is_file(self::$aiomCacheDir . 'aiom.enabled')) @file_put_contents(self::$aiomCacheDir . 'aiom.enabled', time());
		} else {
			if(is_file(self::$aiomCacheDir . 'aiom.enabled')) @unlink(self::$aiomCacheDir . 'aiom.enabled');
		}

		self::_log("Deleted $numRemoved file(s) from " . self::$aiomCacheDir);
		return $numRemoved;
	}

	/**
	 * Expire pages cache folder
	 *
	 * @return int $numRemoved Number of deleted files
	 */
	private static function _clearPagesCache() {
		$numRemoved = 0;
		if(is_dir(self::$pagesCacheDir)) {
			$numRemoved = CacheFile::removeAll(self::$pagesCacheDir);
		}
		self::_log("Deleted $numRemoved file(s) from " . self::$pagesCacheDir);
		return $numRemoved;
	}

	/**
	 * Expire assets cache folder
	 * Check the already cached js/css files according to its lifetime.
	 * If the files already exist longer than the maximum time to live,
	 * they are deleted. The pages cache is also deleted if it least one
	 * cached js/css file is deleted.
	 *
	 * @param boolean $force_all Force delete all the files in the cache folder.
	 * @return int $numRemoved Number of deleted files
	 */
	private static function _clearAssetsCache($force_all = false) {

		clearstatcache();

		$dir = self::$assetsCacheDir;
		if(!is_dir($dir)) return 0;

		$numRemoved1 = $numRemoved2 = 0;
		$now = time();
		$_cacheFiles = new \RecursiveDirectoryIterator($dir, \RecursiveDirectoryIterator::SKIP_DOTS);

		// Remove all files that are older than the maximum lifetime.
		foreach($_cacheFiles as $_cacheFile) {
			/** @var SplFileInfo $_cacheFile */
			if(!$_cacheFile->isFile()) continue;
			$file = $dir . $_cacheFile->getFilename();
			$mtime = filemtime($file);
			//$file = $_cacheFile->getPathname();
			//bd($file, "_clearAssetsCache() checking if file is expired");
			if($mtime !== false && ((int) $mtime + (int) self::$configData['max_cache_lifetime'] < $now || $force_all)) {
				if(wireChmod($file) !== false) {
					if(@unlink($file) === false) {
						self::_log("ERROR: unlink($file) failed");
					} else {
						$numRemoved1++;
						/** @phpstan-ignore if.alwaysTrue */
						if(self::DEBUG) self::_log("Deleted $file");
						//bd($file, "_clearAssetsCache() deleted file");
					}
				} else {
					self::_log("ERROR: wireChmod($file) failed");
				}
			}
		}
		if($numRemoved1 > 0) self::_log("Deleted $numRemoved1 file(s) from $dir");

		//if any css/js file from assets cache is deleted, then invalidate the whole pages cache
		//since cached pages files could point to the just deleted css/js file
		if($numRemoved1 > 0 || $force_all === true) {
			$numRemoved2 = self::_clearPagesCache();
		}

		return $numRemoved1 + $numRemoved2;
	}

	/**
	 * Generate Created date for css/js files and deliver back the data stream.
	 *
	 * @param  string $data The minimized code
	 * @return string The minimized code with generation information
	 */
	private static function _generatorInformation($data) {
		$info = static::getModuleInfo();
		$version = wire()->sanitizer->text($info['version'] ?? '');
		//return (!empty($data)) ? '/** Generated: '.date('l, jS \of F Y, H:i:s').' // Powered by AIOM+ v' . $version . ' **/' . PHP_EOL . $data : '';
		return (!empty($data)) ? '/** Generated: ' . date('r') . ' // Powered by AIOM+ v' . $version . ' **/' . PHP_EOL . $data : '';
	}

	/**
	 * Generate Created date for html files and deliver back the data stream.
	 *
	 * @param  string   $data   The minimized code
	 * @return string           The minimized code with generation information
	 */
	private static function _generatorInformationHtml($data) {
		$info = static::getModuleInfo();
		$version = wire()->sanitizer->text($info['version'] ?? '');
		//return (!empty($data)) ? $data.PHP_EOL.'<!-- Generated: '.date('l, jS \of F Y, H:i:s').' // Powered by AIOM+ v' . $version . ' -->' : '';
		return (!empty($data)) ? $data . PHP_EOL . '<!-- Generated: ' . date('r') . ' // Powered by AIOM+ v' . $version . ' -->' : '';
	}

	/**
	 * Create a unique file name of the files to be combined.
	 *
	 * @param array<int, array{
	 *     absolute_path: string,
	 *     last_modified: int,
	 *     file_extension: string
	 * }> $files File-info entries returned by _fileArray().
	 * @param string $prefix Prefix of the generated cache file e.g. "css_", "js_").
	 * @param string $ext File extension of the generated cache file (e.g. ".css", ".js").
	 * @return string Unique cache-file name, including prefix and extension, with an optional "_dev" suffix.
	 */
	private static function _getCacheName($files, $prefix = 'css_', $ext = '.css') {
		//$_timestamp = 0;
		//foreach ($files as $file) {
			//$_timestamp = ($_timestamp + $file['last_modified']); //original

			//https://processwire.com/talk/topic/5630-module-aiom-all-in-one-minify-for-css-less-js-and-html/?page=7#comment-128784
			//$_timestamp = ((int)$_timestamp + $file['last_modified']);

			//https://github.com/FlipZoomMedia/ProcessWire-AIOM-All-In-One-Minify/issues/64
			//https://processwire.com/talk/topic/17610-problem-when-use-aiom-module/?tab=comments#comment-154782
			//$_timestamp += (int) ($file['last_modified'] + hexdec(md5(basename($file['absolute_path']))));
		//}

		//alternative
		//https://github.com/FlipZoomMedia/ProcessWire-AIOM-All-In-One-Minify/issues/64#issuecomment-360468349
		$hash = md5(print_r($files, true));
		return (self::$configData['development_mode'] != 1) ? $prefix.$hash.$ext : $prefix.$hash.'_dev'.$ext;
	}

	/**
	 * Builds an array of file-info entries for the given asset files.
	 *
	 * @param array<int, string|array{
	 *     loadOn?: string,
	 *     files?: string|array<int, string>
	 * }> $asset_files List of asset file paths or conditional-loading rules
	 * @param string|array<int, string> $extension Allowed file extension(s)
	 * @return array<int, array{
	 *     absolute_path: string,
	 *     last_modified: int,
	 *     file_extension: string
	 * }>
	 */
	private static function _fileArray($asset_files, $extension = '.css') {
		/* $asset_files =
		 *   - ['css/normal.css'],
		 *   - ['css1.css', 'css2.css'],
		 *   - [
		 *       ['loadOn' => 'template=basic-page', 'files' => ['css/one.css', 'css/two.css']]
		 *     ]
		 */
		$extension = is_array($extension) ? $extension : [$extension];
		$current_page_id = wire()->page->id;
		$_asset_files = [];

		foreach($asset_files as $_asset_file) {

			// check for conditional loading (loadOn) find all page ids based on the passed selector
			if(is_array($_asset_file) && isset($_asset_file['loadOn'], $_asset_file['files'])) {
				$conditional_pages = wire()->pages->find($_asset_file['loadOn'])->explode('id'); //findIDs() introduced in PW 3.0.133
				if(in_array($current_page_id, $conditional_pages, true)) {
					$files = is_array($_asset_file['files']) ? $_asset_file['files'] : [$_asset_file['files']];
					foreach ($files as $__asset_file) {
						$_asset_files[] = self::_getFileInfoArray($__asset_file, $extension);
					}
				}
			// No condition, always load
			} else if(is_string($_asset_file)) {
				$_asset_files[] = self::_getFileInfoArray($_asset_file, $extension);
			}

		}

		// Return array with valid file paths and timestamps without null or ampty array entries
		return array_values(array_filter($_asset_files, fn($val) => !is_null($val)));
	}

	/**
	 * Creates a file-info record with absolute path, last-modified timestamp,
	 * and file extension. Returns null if the file does not exist, is remote
	 * and unavailable, or does not match allowed extensions.
	 *
	 * @param string $_file path (or URL) to the asset file.
	 * @param array<int,string> $extension Allowed file extensions.
	 *
	 * @return array{
	 *     absolute_path: string,
	 *     last_modified: int,
	 *     file_extension: string
	 * }|null
	 */
	private static function _getFileInfoArray($_file, $extension) {

		$config = wire()->config;

		// remove cache-busting parameters (?v=1.2.3)
		$cutPos = strcspn($_file, '?#');
		if ($cutPos !== strlen($_file)) {
			$_file = substr($_file, 0, $cutPos);
		}

		$isRemote = self::_isRemote($_file);

		if(strpos($_file, '/') === 0) {
			// absolute path, join with doc root
			$_path = rtrim($config->paths->root, '/') . $_file;
		} elseif ($isRemote && self::_checkRemoteFileAccess($_file)) {
			// remote file must be treated as existing
			// use max_cache_lifetime as a placeholder because filemtime() doesn't work with http requests
			return [
				'absolute_path'  => $_file,
				'file_extension' => pathinfo($_file, PATHINFO_EXTENSION),
				'last_modified'  => time() - (int) self::$configData['max_cache_lifetime']
			];
		} else {
			// relative path to templates dir
			$_path = (self::$configData['directory_traversal'] != 1)
							? str_ireplace(['../', './', '%2e%2e%2f', '..%2F'], '', $config->paths->templates . $_file)
							: $config->paths->templates . $_file;
		}

		// File must exist locally
		if (!$isRemote && !file_exists($_path)) {
			self::_log("ERROR: $_path does not exist");
			return null;
		}

		// Extension must match allowed list
		if (!self::_has_needle($_path, $extension)) {
			self::_log("ERROR: invalid extension for $_path");
			return null;
		}

		clearstatcache();

		return [
			'absolute_path'  => $_path,
			'file_extension' => pathinfo($_path, PATHINFO_EXTENSION),
			'last_modified'  => filemtime($_path) ?: time(),
		];
}

/*
	private static function _getFileInfoArrayOld($_file, $extension) {
		$config = wire()->config;
		$return = null;

		//MP leave just filename, remove everything after ? and #, tipicaly used for cache busting eg. file.css?v=2.0.1
		$cutPos = strcspn($_file, '?#');
		if ($cutPos !== strlen($_file)) {
			$_file = substr($_file, 0, $cutPos);
		}

		$isRemote = self::_isRemote($_file);

		// Filter Directory Traversal (default: yes)
		// Check existence and whether there is internal/external source.
